<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/informacion_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InformacionActivity">

    <!-- ============================================================
         HEADER MORADO CON GRADIENTE (estilo banner del horario)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/header_titulo"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/fondo_degradado"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/info_texto_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/texto_info_titulo"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============================================================
         SCROLL CON LAS CARDVIEWS DE INFORMACIÓN
         ============================================================ -->
    <ScrollView
        android:id="@+id/scrollview_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_titulo">

        <LinearLayout
            android:id="@+id/linearlayout_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ====== TARJETA: EQUIPO DESARROLLADOR ====== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/info_cardview_equipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/color_cabecera"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:id="@+id/info_linearlayout_cardview_equipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_texto_equipo_desarrollador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/texto_titulo_equipo"
                        android:textColor="@color/color_textos_cambiados"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_texto_integrantes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/texto_integrantes"
                        android:textColor="@color/color_textos_cambiados" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ====== TARJETA: INFORMACIÓN ACADÉMICA ====== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/info_cardview_asignatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/color_cabecera"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:id="@+id/info_linearlayout_carview_asig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_texto_titulo_asig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/texto_titulo_asig"
                        android:textColor="@color/color_textos_cambiados"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_texto_asig_datos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/texto_asig_datos"
                        android:textColor="@color/color_textos_cambiados" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ====== TARJETA: APIS Y RECURSOS ====== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/info_cardview_recursos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/color_cabecera"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:id="@+id/info_linearlayout_cardview_recursos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_texto_titulo_recursos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/texto_recursos_titulo"
                        android:textColor="@color/color_textos_cambiados"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_texto_recursos_datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/texto_recursos_datos"
                        android:textColor="@color/color_textos_cambiados" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ====== TARJETA: PERMISOS ====== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/info_cardview_permisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/color_cabecera"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:contentPadding="20dp">

                <LinearLayout
                    android:id="@+id/info_linearlayout_cardview_permisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_texto_titulo_permisos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/texto_permisos_titulo"
                        android:textColor="@color/color_textos_cambiados"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/info_texto_permisos_datos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/texto_permisos_datos"
                        android:textColor="@color/color_textos_cambiados" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>