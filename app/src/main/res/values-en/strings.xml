    <string name="texto_integrantes"><![CDATA[Developed by:<br>•Joaquín Ramón Pérez Rogerio<br>• Jiana Lin<br>• Darío López Villegas<br><br>---- Group 15 ----<br><br>Source code available in <a href="https://github.com/darlopvil/ETSII-GO.git">our GitHub repository</a>.]]></string>
    <string name="texto_titulo_asig">🎓 Academic Information</string>
    <string name="texto_asig_datos"><![CDATA[• Subject: Mobile Computing<br>• Academic Year: 2025–2026<br>• <a href="https://www.informatica.us.es">Higher Technical School of Computer Engineering (ETSII)</a><br>• <a href="https://www.us.es">University of Seville<a/>]]></string>
    <string name="texto_recursos_titulo">🔌 Consumed APIs and Used Resources</string>
    <string name="texto_recursos_datos"><![CDATA[• <b><a href="https://developers.google.com/maps/documentation/routes/compute-route-over">Google Routes API v2</a></b>: Advanced calculation of routes, distances, and travel times.\n<br><br>• <b><a href="https://developers.google.com/maps/documentation/places/android-sdk">Google Places API (Autocomplete)</a>:</b> Predictive smart search engine with autocomplete and precise address validation.<br><br>• <b><a href="https://developers.google.com/location-context/fused-location-provider">FusedLocationProviderClient</a></b>: High-precision geolocation using GPS, WiFi, and Bluetooth.\n<br><br>• <b><a href="https://cda-idesevilla.opendata.arcgis.com/datasets/ideSEVILLA::tussam-paradas/explore?showTable=true">ParadasTussam.csv</a></b>: Dataset of TUSSAM bus stops from the Urban Planning and Environment Department of the Seville City Council.]]></string>
    <string name="texto_permisos_titulo">🛡️ Required System Permissions</string>
    <string name="texto_permisos_datos"><![CDATA[• <b>INTERNET:</b> Required to connect to Google servers and download routes.<br>• <b>ACCESS_FINE_LOCATION:</b> Allows using the GPS hardware to get your exact location.<br>• <b>ACCESS_COARSE_LOCATION:</b> Allows triangulating your approximate location using cell towers and Wi-Fi for faster positioning with lower battery consumption.]]></string>
